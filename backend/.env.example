# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# JWT
JWT_SECRET_KEY=change-me-to-another-long-random-string

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=lexy
MYSQL_PASSWORD=lexy_password
MYSQL_DATABASE=lexy_files

# Redis
REDIS_URL=redis://localhost:6379/0

# File storage
STORAGE_BACKEND=local
UPLOAD_FOLDER=./uploads

# S3-compatible storage (required when STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_S3_PREFIX=uploads
AWS_S3_ENDPOINT_URL=

# Max content length (bytes) — 5 GB
MAX_CONTENT_LENGTH=5368709120

# CORS
CORS_ORIGINS=http://localhost:3000
SOCKETIO_CORS_ORIGINS=http://localhost:3000

# APScheduler
SCHEDULER_ENABLED=true
CLEANUP_INTERVAL_MINUTES=30
